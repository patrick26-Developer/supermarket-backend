# Copiez ce fichier en `.env` et adaptez les valeurs à votre environnement local.
# `.env` est ignoré par git (voir .gitignore) — ne jamais committer de secrets.

# Connexion PostgreSQL — correspond au service `postgres` de docker-compose.yml
DATABASE_URL="postgresql://postgres:patrick123@localhost:5432/superette_db"

# Secrets JWT — générez vos propres valeurs, par ex. avec :
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

NODE_ENV="development"
PORT=3000
API_PREFIX="api"

# Utilisés par `npm run seed` pour créer le compte admin initial
SEED_ADMIN_EMAIL="admin@superette.local"
SEED_ADMIN_PHONE="+242060000000"
SEED_ADMIN_PASSWORD="change-me"
