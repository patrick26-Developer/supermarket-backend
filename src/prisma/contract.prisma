// ---------------------------------------------------------------
// User / Access
// ---------------------------------------------------------------

enum UserStatus {
  @@type("pg/text@1")
  ACTIVE
  INVITED
  SUSPENDED
  BLOCKED
  INACTIVE
  ARCHIVED
}

enum RoleCode {
  @@type("pg/text@1")
  SUPER_ADMIN
  ADMIN
  STORE_MANAGER
  CASHIER
  STOCK_MANAGER
  PURCHASING_MANAGER
  SALES_MANAGER
  ACCOUNTANT
  DELIVERY_AGENT
  AUDITOR
  CUSTOMER
}

enum PermissionAction {
  @@type("pg/text@1")
  CREATE
  READ
  UPDATE
  DELETE
  APPROVE
  CANCEL
  REFUND
  EXPORT
  PRINT
  OPEN
  CLOSE
  ADJUST
  TRANSFER
}

enum PermissionResource {
  @@type("pg/text@1")
  USERS
  ROLES
  PERMISSIONS
  ORGANIZATIONS
  STORES
  PRODUCTS
  CATEGORIES
  BRANDS
  PRICES
  SUPPLIERS
  PURCHASE_ORDERS
  GOODS_RECEIPTS
  STOCK
  INVENTORIES
  CUSTOMERS
  ORDERS
  SALES
  CASH_REGISTERS
  CASH_SESSIONS
  CASH_MOVEMENTS
  PAYMENTS
  RECEIPTS
  INVOICES
  DELIVERIES
  REPORTS
  AUDIT_LOGS
}

// ---------------------------------------------------------------
// Organization
// ---------------------------------------------------------------

enum OrganizationStatus {
  @@type("pg/text@1")
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum StoreStatus {
  @@type("pg/text@1")
  ACTIVE
  TEMPORARILY_CLOSED
  SUSPENDED
  CLOSED
}

// ---------------------------------------------------------------
// Product
// ---------------------------------------------------------------

enum ProductStatus {
  @@type("pg/text@1")
  ACTIVE
  INACTIVE
  DISCONTINUED
  ARCHIVED
}

enum ProductType {
  @@type("pg/text@1")
  STANDARD
  WEIGHTED
  SERVICE
  COMBO
}

enum UnitType {
  @@type("pg/text@1")
  PIECE
  KILOGRAM
  GRAM
  LITER
  MILLILITER
  METER
  PACK
  BOX
  BOTTLE
  CAN
}

// ---------------------------------------------------------------
// Purchase
// ---------------------------------------------------------------

enum PurchaseOrderStatus {
  @@type("pg/text@1")
  DRAFT
  SUBMITTED
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
  CLOSED
}

enum GoodsReceiptStatus {
  @@type("pg/text@1")
  DRAFT
  RECEIVED
  CANCELLED
}

// ---------------------------------------------------------------
// Stock
// ---------------------------------------------------------------

enum StockMovementType {
  @@type("pg/text@1")
  PURCHASE_RECEIPT
  SALE
  SALE_RETURN
  PURCHASE_RETURN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT
  INVENTORY_CORRECTION
  DAMAGED
  EXPIRED
  LOST
}

enum StockAdjustmentStatus {
  @@type("pg/text@1")
  DRAFT
  SUBMITTED
  APPROVED
  APPLIED
  CANCELLED
}

enum InventoryCountStatus {
  @@type("pg/text@1")
  DRAFT
  IN_PROGRESS
  COMPLETED
  APPROVED
  CANCELLED
}

