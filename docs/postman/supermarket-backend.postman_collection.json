{
  "info": {
    "name": "Supermarket Backend",
    "description": "Collection de test pour l'API supermarket-backend (auth + endpoints protégés). Importer avec l'environnement supermarket-backend.postman_environment.json.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Health check (public)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/",
        "auth": { "type": "noauth" }
      }
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('accessToken', body.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', body.refreshToken);",
                  "  console.log('Tokens enregistrés pour', body.user.email, body.user.roles);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            }
          }
        },
        {
          "name": "Refresh",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('accessToken', body.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', body.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/refresh",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "List users",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/users"
          }
        }
      ]
    },
    {
      "name": "Catalog",
      "item": [
        {
          "name": "Categories",
          "item": [
            { "name": "List", "request": { "method": "GET", "url": "{{baseUrl}}/api/categories" } },
            { "name": "Get one", "request": { "method": "GET", "url": "{{baseUrl}}/api/categories/:id" } },
            {
              "name": "Create",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code === 201) {",
                      "  pm.collectionVariables.set('categoryId', pm.response.json().id);",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "url": "{{baseUrl}}/api/categories",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"name\": \"Boissons\",\n  \"slug\": \"boissons\"\n}" }
              }
            },
            {
              "name": "Update",
              "request": {
                "method": "PUT",
                "url": "{{baseUrl}}/api/categories/{{categoryId}}",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"description\": \"Sodas et jus\"\n}" }
              }
            },
            { "name": "Delete", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/categories/{{categoryId}}" } }
          ]
        },
        {
          "name": "Brands",
          "item": [
            { "name": "List", "request": { "method": "GET", "url": "{{baseUrl}}/api/brands" } },
            { "name": "Get one", "request": { "method": "GET", "url": "{{baseUrl}}/api/brands/:id" } },
            {
              "name": "Create",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code === 201) {",
                      "  pm.collectionVariables.set('brandId', pm.response.json().id);",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "url": "{{baseUrl}}/api/brands",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"name\": \"Coca-Cola\",\n  \"slug\": \"coca-cola\"\n}" }
              }
            },
            { "name": "Update", "request": { "method": "PUT", "url": "{{baseUrl}}/api/brands/{{brandId}}", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"description\": \"Boissons gazeuses\"\n}" } } },
            { "name": "Delete", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/brands/{{brandId}}" } }
          ]
        },
        {
          "name": "Products",
          "item": [
            { "name": "List / search (?search=)", "request": { "method": "GET", "url": "{{baseUrl}}/api/products?search=coca" } },
            { "name": "Get one", "request": { "method": "GET", "url": "{{baseUrl}}/api/products/:id" } },
            { "name": "Lookup by SKU/barcode", "request": { "method": "GET", "url": "{{baseUrl}}/api/products/code/COCA-33CL" } },
            {
              "name": "Create",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code === 201) {",
                      "  pm.collectionVariables.set('productId', pm.response.json().id);",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "url": "{{baseUrl}}/api/products",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"sku\": \"COCA-33CL\",\n  \"name\": \"Coca-Cola 33cl\",\n  \"slug\": \"coca-cola-33cl\",\n  \"categoryId\": \"{{categoryId}}\",\n  \"brandId\": \"{{brandId}}\",\n  \"costPrice\": 300,\n  \"taxRate\": 18,\n  \"reorderLevel\": 20,\n  \"minimumStock\": 10\n}"
                }
              }
            },
            { "name": "Update", "request": { "method": "PUT", "url": "{{baseUrl}}/api/products/{{productId}}", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"costPrice\": 320\n}" } } },
            { "name": "Delete", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/products/{{productId}}" } }
          ]
        }
      ]
    },
    {
      "name": "Stock",
      "item": [
        { "name": "List (filtrable ?storeId=&productId=)", "request": { "method": "GET", "url": "{{baseUrl}}/api/stock" } },
        { "name": "Get one", "request": { "method": "GET", "url": "{{baseUrl}}/api/stock/{{storeId}}/{{productId}}" } },
        { "name": "Movements history", "request": { "method": "GET", "url": "{{baseUrl}}/api/stock/movements?productId={{productId}}" } },
        {
          "name": "Record movement (PURCHASE_RECEIPT)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/stock/movements",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"storeId\": \"{{storeId}}\",\n  \"productId\": \"{{productId}}\",\n  \"type\": \"PURCHASE_RECEIPT\",\n  \"quantity\": 50,\n  \"unitCost\": 1000\n}" }
          }
        }
      ]
    },
    {
      "name": "Cash",
      "item": [
        {
          "name": "Create register",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 201) { pm.collectionVariables.set('cashRegisterId', pm.response.json().id); }"] } }],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/cash-registers",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"storeId\": \"{{storeId}}\",\n  \"code\": \"CAISSE-1\",\n  \"name\": \"Caisse principale\"\n}" }
          }
        },
        { "name": "List registers", "request": { "method": "GET", "url": "{{baseUrl}}/api/cash-registers" } },
        {
          "name": "Open session",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 201) { pm.collectionVariables.set('sessionId', pm.response.json().id); }"] } }],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/cash-sessions/open",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"cashRegisterId\": \"{{cashRegisterId}}\",\n  \"openingAmount\": 5000\n}" }
          }
        },
        { "name": "Get session", "request": { "method": "GET", "url": "{{baseUrl}}/api/cash-sessions/{{sessionId}}" } },
        {
          "name": "Record manual movement (EXPENSE)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/cash-sessions/{{sessionId}}/movements",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"type\": \"EXPENSE\",\n  \"amount\": 1000,\n  \"reason\": \"Achat fournitures\"\n}" }
          }
        },
        {
          "name": "Close session",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/cash-sessions/{{sessionId}}/close",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"actualAmount\": 32000,\n  \"notes\": \"RAS\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Sales",
      "item": [
        { "name": "List (?storeId=&sessionId=)", "request": { "method": "GET", "url": "{{baseUrl}}/api/sales" } },
        { "name": "Get one (avec items + payments)", "request": { "method": "GET", "url": "{{baseUrl}}/api/sales/{{saleId}}" } },
        {
          "name": "Create sale (1 article, paiement CASH)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 201) { pm.collectionVariables.set('saleId', pm.response.json().id); }"] } }],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/sales",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"storeId\": \"{{storeId}}\",\n  \"sessionId\": \"{{sessionId}}\",\n  \"items\": [\n    { \"productId\": \"{{productId}}\", \"quantity\": 2, \"unitPrice\": 4000 }\n  ],\n  \"payments\": [\n    { \"method\": \"CASH\", \"amount\": 8000 }\n  ]\n}"
            }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "categoryId", "value": "" },
    { "key": "brandId", "value": "" },
    { "key": "productId", "value": "" },
    { "key": "storeId", "value": "", "description": "Id du magasin par défaut créé par npm run seed — à renseigner manuellement (voir pgAdmin ou GET /api/stock après une première requête)." },
    { "key": "cashRegisterId", "value": "" },
    { "key": "sessionId", "value": "" },
    { "key": "saleId", "value": "" }
  ]
}
